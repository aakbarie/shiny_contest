# Shiny App Generator - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# LLM Configuration
# ============================================================================
LLM_MODEL=deepseek-coder-v2
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Server Configuration
# ============================================================================
APP_HOST=0.0.0.0
APP_PORT=8050

# ============================================================================
# Security Settings
# ============================================================================
# Maximum file upload size in MB
MAX_FILE_SIZE_MB=50

# Maximum length for user description input
MAX_DESCRIPTION_LENGTH=1000

# Code execution timeout in seconds
CODE_EXECUTION_TIMEOUT=30

# Maximum memory for generated app in MB
MAX_MEMORY_MB=512

# ============================================================================
# File Storage
# ============================================================================
# Directory for uploaded files (will be created if doesn't exist)
UPLOAD_DIR=./uploads

# Directory for generated apps (will be created if doesn't exist)
GENERATED_DIR=./generated_apps

# Temporary directory for code execution
TEMP_DIR=./temp

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty for console only)
LOG_FILE=./logs/app.log

# Enable request ID tracking for debugging
ENABLE_REQUEST_ID=true

# ============================================================================
# Rate Limiting
# ============================================================================
# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Maximum requests per minute per IP
RATE_LIMIT_PER_MINUTE=10

# ============================================================================
# Features
# ============================================================================
# Enable PyGWalker by default
PYGWALKER_DEFAULT=true

# Enable code download feature
ENABLE_CODE_DOWNLOAD=true

# ============================================================================
# Development Settings
# ============================================================================
# Enable debug mode (more verbose logging, auto-reload)
DEBUG=false

# Environment: development, staging, production
ENVIRONMENT=development
